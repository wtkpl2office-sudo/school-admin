{
  "functions": {
    "api/**/*.ts": {
      "includeFiles": "public/fonts/**",
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/deadline-reminder",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/director-pending-reminder",
      "schedule": "0 1 * * 1-5"
    },
    {
      "path": "/api/weekly-executive-workload-digest",
      "schedule": "30 0 * * 1"
    },
    {
      "path": "/api/weekly-backup",
      "schedule": "0 0 * * 0"
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/$1" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}